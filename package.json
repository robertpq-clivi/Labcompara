{
  "name": "medcompara",
  "version": "1.0.0",
  "description": "Comparador de precios de estudios de laboratorio en México, con scan automático semanal",
  "scripts": {
    "generate:sitemaps": "node scripts/generate-sitemaps.js",
    "comparativas": "node scripts/generar-comparativas.js",
    "comparativas:apply": "node scripts/generar-comparativas.js --apply",
    "predeploy": "npm run comparativas:apply && npm run blog:medicinas:apply && npm run generate:sitemaps",
    "scan:offline": "node scripts/scan-labs.js --offline",
    "scan:apply": "node scripts/scan-labs.js --offline --apply",
    "test": "node scripts/test-match.js && node scripts/test-farmacias.js && node scripts/test-medicinas.js && node scripts/test-captura.js && node scripts/test-feed.js",
    "expandir": "node scripts/expandir-catalogo.js",
    "expandir:apply": "node scripts/expandir-catalogo.js --apply",
    "scan:labs": "node scripts/scan-labs.js",
    "scan:farmacias": "node scripts/scan-farmacias.js",
    "scan:medicinas": "node scripts/scan-medicinas.js",
    "catalogo:medicinas": "node scripts/construir-catalogo-medicinas.js",
    "catalogo:medicinas:apply": "node scripts/construir-catalogo-medicinas.js --apply",
    "blog:medicinas": "node scripts/generar-blog-medicinas.js",
    "blog:medicinas:apply": "node scripts/generar-blog-medicinas.js --apply"
  },
  "engines": {
    "node": ">=16"
  }
}
