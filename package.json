{
  "name": "labcompara",
  "version": "1.0.0",
  "description": "Comparador de precios de estudios de laboratorio en México, con scan automático semanal",
  "scripts": {
    "generate:sitemaps": "node scripts/generate-sitemaps.js",
    "predeploy": "npm run generate:sitemaps",
    "scan": "node scripts/scan-labs.js",
    "scan:offline": "node scripts/scan-labs.js --offline",
    "scan:apply": "node scripts/scan-labs.js --offline --apply",
    "test": "node scripts/test-match.js && node scripts/test-feed.js"
  },
  "engines": {
    "node": ">=16"
  }
}
